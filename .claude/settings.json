{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/expression-check.sh",
            "timeout": 60,
            "statusMessage": "Checking copy against the Expression Guidelines"
          }
        ]
      }
    ]
  }
}
