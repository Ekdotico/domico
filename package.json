{
  "name": "@ekdotico/domico",
  "version": "0.36.0",
  "private": false,
  "description": "Domico — the Ekdotico house style: design tokens, base styles, shared components, and the Expression Guidelines with their machine-readable vocabulary and prohibited terms.",
  "license": "AGPL-3.0-only",
  "author": "Ekdotico",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ekdotico/domico.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "type": "module",
  "bin": {
    "ekdotico-lint": "./dist/src/lint/cli.js",
    "ekdotico-check": "./dist/src/check/cli.js"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "tokens/generated",
    "tokens/source",
    "tokens/lib",
    "scripts",
    "assets",
    "expression/*.md",
    "docs/*.md",
    "AGENTS.md",
    "LICENSE",
    "TRADEMARKS.md",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "exports": {
    "./tokens": {
      "types": "./dist/tokens/generated/tokens.d.ts",
      "default": "./dist/tokens/generated/tokens.js"
    },
    "./tokens.css": "./tokens/generated/tokens.css",
    "./mermaid": {
      "types": "./dist/tokens/generated/mermaid.d.ts",
      "default": "./dist/tokens/generated/mermaid.js"
    },
    "./mermaid/accessibility": {
      "types": "./dist/src/mermaid/accessibility.d.ts",
      "default": "./dist/src/mermaid/accessibility.js"
    },
    "./svg": {
      "types": "./dist/src/svg/annotate.d.ts",
      "default": "./dist/src/svg/annotate.js"
    },
    "./styles.css": "./dist/styles/base.css",
    "./styles/base.css": "./dist/styles/base-only.css",
    "./styles/reset.css": "./dist/styles/reset-only.css",
    "./styles/type.css": "./dist/styles/type-only.css",
    "./styles/components.css": "./dist/styles/components.css",
    "./styles/appearance.css": "./dist/styles/appearance-only.css",
    "./styles/primitives.css": "./dist/styles/primitives.css",
    "./styles/badge.css": "./dist/styles/badge.css",
    "./styles/callout.css": "./dist/styles/callout.css",
    "./styles/figure.css": "./dist/styles/figure.css",
    "./styles/keyvalue.css": "./dist/styles/keyvalue.css",
    "./styles/logo.css": "./dist/styles/logo.css",
    "./styles/section-rule.css": "./dist/styles/section-rule.css",
    "./styles/stat.css": "./dist/styles/stat.css",
    "./styles/table.css": "./dist/styles/table.css",
    "./styles/tabs.css": "./dist/styles/tabs.css",
    "./styles/access-gate.css": "./dist/styles/access-gate.css",
    "./styles/nav-drawer.css": "./dist/styles/nav-drawer.css",
    "./styles/on-this-page.css": "./dist/styles/on-this-page.css",
    "./styles/doc-meta.css": "./dist/styles/doc-meta.css",
    "./styles/opening-sequence.css": "./dist/styles/opening-sequence.css",
    "./styles/button.css": "./dist/styles/button.css",
    "./styles/form.css": "./dist/styles/form.css",
    "./styles/dialog.css": "./dist/styles/dialog.css",
    "./styles/tooltip.css": "./dist/styles/tooltip.css",
    "./styles/page-heading.css": "./dist/styles/page-heading.css",
    "./styles/toolbar.css": "./dist/styles/toolbar.css",
    "./styles/menu.css": "./dist/styles/menu.css",
    "./styles/option-list.css": "./dist/styles/option-list.css",
    "./styles/sync-status.css": "./dist/styles/sync-status.css",
    "./styles/avatar.css": "./dist/styles/avatar.css",
    "./styles/editor.css": "./dist/styles/editor.css",
    "./styles/code.css": "./dist/styles/code.css",
    "./components": {
      "types": "./dist/src/components/index.d.ts",
      "default": "./dist/src/components/index.js"
    },
    "./icons": {
      "types": "./dist/src/components/icons.d.ts",
      "default": "./dist/src/components/icons.js"
    },
    "./a11y": {
      "types": "./dist/src/a11y/index.d.ts",
      "default": "./dist/src/a11y/index.js"
    },
    "./theme": {
      "types": "./dist/src/theme/index.d.ts",
      "default": "./dist/src/theme/index.js"
    },
    "./theme/server": {
      "types": "./dist/src/theme/server.d.ts",
      "default": "./dist/src/theme/server.js"
    },
    "./fonts": {
      "types": "./dist/src/fonts/index.d.ts",
      "default": "./dist/src/fonts/index.js"
    },
    "./assets": {
      "types": "./dist/src/assets/index.d.ts",
      "default": "./dist/src/assets/index.js"
    },
    "./expression": {
      "types": "./dist/src/expression/index.d.ts",
      "default": "./dist/src/expression/index.js"
    },
    "./lint": {
      "types": "./dist/src/lint/index.d.ts",
      "default": "./dist/src/lint/index.js"
    },
    "./expression/vocabulary.json": "./dist/expression/vocabulary.json",
    "./expression/prohibited.json": "./dist/expression/prohibited.json",
    "./expression/guidelines.md": "./expression/guidelines.md",
    "./expression/registers.md": "./expression/registers.md",
    "./assets/*": "./assets/*",
    "./AGENTS.md": "./AGENTS.md",
    "./docs/design-tokens.md": "./docs/design-tokens.md",
    "./docs/visual-ruleset.md": "./docs/visual-ruleset.md",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:tokens": "node tokens/build.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "build:expression": "node scripts/build-expression.mjs",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "pnpm build:tokens && pnpm build:expression && pnpm build:ts && pnpm build:styles",
    "check:generated": "node scripts/check-generated.mjs",
    "check:expression": "node scripts/check-expression-sync.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:appearance": "node scripts/check-appearance.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:collaborators": "node scripts/check-collaborators.mjs",
    "check:styles": "node scripts/check-styles.mjs",
    "check:discipline": "node scripts/check-discipline.mjs .",
    "check:a11y": "node scripts/check-a11y.mjs .",
    "check:svg": "node scripts/check-svg.mjs",
    "check:components": "node scripts/check-components.mjs",
    "check:decay": "node scripts/check-decay.mjs .",
    "check:consumers": "node scripts/check-consumers.mjs",
    "check:ruleset": "node ruleset/verify.mjs",
    "build:ruleset": "node ruleset/build.mjs",
    "lint:copy": "node dist/src/lint/cli.js",
    "hooks:install": "node scripts/install-agent-hooks.mjs --target .",
    "hooks:check": "node scripts/install-agent-hooks.mjs --check --target .",
    "prepare": "node scripts/install-agent-hooks.mjs --target .",
    "lint:fixture": "node scripts/check-lint-fixture.mjs",
    "check": "pnpm check:generated && pnpm check:expression && pnpm check:exports && pnpm check:icons && pnpm check:appearance && pnpm check:contrast && pnpm check:collaborators && pnpm check:styles && pnpm check:discipline && pnpm check:a11y && pnpm check:svg && pnpm check:components && pnpm check:ruleset && pnpm lint:fixture && pnpm lint:copy && tsc -p tsconfig.json --noEmit",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "ajv": "^8",
    "jsdom": "^30.0.1",
    "lucide-static": "^1.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "style-dictionary": "^5.5.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.6",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "qs": "^6.16.0"
    }
  }
}
